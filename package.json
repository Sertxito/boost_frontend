{
  "name": "boost-frontend",
  "version": "1.0.0",
  "description": "Frontend Expert Boost for Angular and React with accessibility, performance, testing and architecture workflows.",
  "type": "module",
  "exports": {
    "./plugin": "./plugin.json",
    "./boost.json": "./boost.json",
    "./package.json": "./package.json"
  },
  "files": [
    "boost.json",
    "plugin.json",
    "agents",
    "instructions",
    "prompts",
    "skills",
    "specs",
    "templates",
    "docs",
    "references",
    "examples",
    "evals",
    "scripts",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "CHANGELOG.md",
    ".github/copilot-instructions.md"
  ],
  "scripts": {
    "validate:json": "node -e \"const fs=require('fs'); ['boost.json','plugin.json','.releaserc.json'].forEach((f)=>JSON.parse(fs.readFileSync(f,'utf8'))); console.log('JSON metadata OK');\"",
    "evals": "node scripts/run-evals.mjs",
    "quality": "npm run validate:json && npm run evals",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "boost:install": "node scripts/install.mjs",
    "boost:check": "node scripts/install.mjs --check"
  },
  "keywords": [
    "frontend",
    "angular",
    "react",
    "accessibility",
    "performance",
    "testing",
    "design-system",
    "microfrontends",
    "agents",
    "skills",
    "copilot",
    "github-copilot",
    "agent-skills"
  ],
  "author": "Sergio Hierro Cinos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sertxito/boost_frontend.git"
  },
  "bugs": {
    "url": "https://github.com/Sertxito/boost_frontend/issues"
  },
  "homepage": "https://github.com/Sertxito/boost_frontend#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^11.0.3",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^24.2.7"
  },
  "bin": {
    "boost-frontend": "scripts/install.mjs"
  }
}
